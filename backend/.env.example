# Copia este archivo a .env y rellena tus propios valores.
#
# IMPORTANTE: ninguna variable de este archivo debe ser una seed phrase,
# clave privada de wallet ni credencial de custodia. Este proyecto solo
# usa claves de LECTURA de APIs públicas.

# RPC de Solana dedicado (recomendado). El público de mainnet-beta está
# confirmado como NO apto para uso sostenido. Regístrate gratis en Helius,
# Alchemy o Syndica (solo necesitas un email) y pon aquí tu URL con key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Opcional: clave de lectura de Birdeye (free tier limitado).
BIRDEYE_API_KEY=

# Ver docs/data-sources.md: el decoder de la bonding curve de pump.fun no
# está verificado contra el programa en vivo. Déjalo en false hasta
# confirmarlo explícitamente (ver backend/app/onchain/pumpfun_decoder.py).
PUMPFUN_PROGRAM_ID_CONFIRMED=false
PUMPFUN_PROGRAM_ID=

DATABASE_URL=sqlite+aiosqlite:///./tracker.db

CORS_ALLOW_ORIGINS=http://localhost:3000
