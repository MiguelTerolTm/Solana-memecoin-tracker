# Copia este archivo a .env y rellena tus propios valores.
#
# IMPORTANTE: ninguna variable de este archivo debe ser una seed phrase,
# clave privada de wallet ni credencial de custodia. Este proyecto solo
# usa claves de LECTURA de APIs públicas.

# RPC de Solana dedicado (recomendado). El público de mainnet-beta está
# confirmado como NO apto para uso sostenido. Regístrate gratis en Helius,
# Alchemy o Syndica (solo necesitas un email) y pon aquí tu URL con key.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# URL websocket para detección casi-tiempo-real de actividad de pump.fun
# (ver backend/app/onchain/pumpfun_listener.py). Con Helius (plan Free):
# wss://mainnet.helius-rpc.com/?api-key=TU_KEY_GRATIS
# Déjalo vacío si no quieres esta funcionalidad todavía; el resto del
# sistema funciona igual por polling.
SOLANA_WS_URL=

# Opcional: clave de lectura de Birdeye (free tier limitado).
BIRDEYE_API_KEY=

# El layout de la bonding curve de pump.fun fue verificado el 7/sep/2026 contra
# fuentes oficiales (ver backend/app/onchain/pumpfun_decoder.py). Puedes activarlo:
PUMPFUN_PROGRAM_ID_CONFIRMED=true
PUMPFUN_PROGRAM_ID=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P

DATABASE_URL=sqlite+aiosqlite:///./tracker.db

CORS_ALLOW_ORIGINS=http://localhost:3000
